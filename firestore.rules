rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザーのデータ（プロフィール・アーカイブ）は、本人だけが読み書きできる
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 全員への匿名公開（public・publicOwners）はやめた（#120）。ここに書いていないものは、だれも読み書きできない

    // ---- グループ（「みんなの はてな」で はてなを見せあう。docs/03-technical.md 6章） ----
    // グループ（groups/{groupId}）と管理者は、人が Firebase のコンソールで作る（アプリからは作れない）

    function groupDoc(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function memberDoc(groupId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid);
    }

    function isMember(groupId) {
      return request.auth != null && exists(memberDoc(groupId));
    }

    function isAdmin(groupId) {
      return isMember(groupId) && get(memberDoc(groupId)).data.role == 'admin';
    }

    // 自分で入れるのは、グループに autoJoinUntil（期限の日時）があって、その前のときだけ
    function autoJoinOpen(groupId) {
      return exists(groupDoc(groupId))
        && get(groupDoc(groupId)).data.get('autoJoinUntil', null) is timestamp
        && request.time < get(groupDoc(groupId)).data.autoJoinUntil;
    }

    function postDoc(groupId, postId) {
      return /databases/$(database)/documents/groups/$(groupId)/posts/$(postId);
    }

    function ownerDoc(groupId, postId) {
      return /databases/$(database)/documents/groups/$(groupId)/owners/$(postId);
    }

    function isPostOwner(groupId, postId) {
      return exists(ownerDoc(groupId, postId)) && get(ownerDoc(groupId, postId)).data.uid == request.auth.uid;
    }

    // 投稿が、アプリが作る形（項目・型・文字数・画像の大きさ）かを確かめる。
    // 画像は、切り抜きの JPEG（base64）で 600,000 文字まで（src/lib/constants.ts の IMAGE_MAX_BASE64_BYTES）。
    // 問題文は 400 文字まで（src/server/llm/validate.ts）。createdAt は端末の時計なので、10分先まではゆるす。
    // 同じ人の投稿をひも付けられないよう、持ち主（uid）・ニックネーム・ユーザー名は入れない（持ち主は owners に分ける）
    function validPost(postId) {
      let d = request.resource.data;
      let subjects = ['math', 'science', 'info'];
      return d.keys().hasOnly(['id', 'createdAt', 'image', 'text', 'subject', 'topic', 'title'])
        && d.keys().hasAll(['id', 'createdAt', 'image', 'text', 'subject', 'topic', 'title'])
        && d.id is string && d.id == postId
        && d.createdAt is number && d.createdAt > 0 && d.createdAt <= request.time.toMillis() + 600000
        && d.image is string && d.image.size() <= 650000 && d.image.matches('^data:image/jpeg;base64,.*')
        && d.text is string && d.text.size() > 0 && d.text.size() <= 400
        && d.subject in subjects
        && d.topic is string && d.topic.size() <= 100
        // 称号：はじめの称号（null）・前の形（分類の名前）・金銀銅の称号（「math-gold」など。src/lib/titles.ts）
        && (d.title == null || d.title in subjects
          || (d.title is string && d.title.size() <= 32 && d.title.matches('^[a-z]+-(bronze|silver|gold)$')));
    }

    // ---- 参加コード（#137） ----
    // joinCodes/{コード}：groupId・open（受付中か）・createdAt。コードを知っている人だけが、そのグループに入れる。
    // コードは 8 文字（見まちがえやすい 0・O・1・I・L を使わない英大文字と数字）。一覧はだれも読めない（総当たりで当てられないように）
    function joinCodeDoc(code) {
      return /databases/$(database)/documents/joinCodes/$(code);
    }

    // 自分で入るときに、受付中の、このグループのコードを入れているか
    function joinCodeOk(groupId) {
      let code = request.resource.data.get('joinCode', null);
      return code is string
        && exists(joinCodeDoc(code))
        && get(joinCodeDoc(code)).data.groupId == groupId
        && get(joinCodeDoc(code)).data.open == true;
    }

    match /joinCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      // 作れるのは管理者だけで、グループの文書の joinCode を同じバッチで このコードにする
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['groupId', 'open', 'createdAt'])
        && request.resource.data.keys().hasAll(['groupId', 'open', 'createdAt'])
        && request.resource.data.groupId is string
        && isAdmin(request.resource.data.groupId)
        && request.resource.data.open is bool
        && request.resource.data.createdAt == request.time
        && code.matches('^[A-HJKMNP-Z2-9]{8}$')
        && getAfter(groupDoc(request.resource.data.groupId)).data.get('joinCode', null) == code;
      // 受付を止める・再開するのは管理者だけ
      allow update: if isAdmin(resource.data.groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open'])
        && request.resource.data.open is bool;
      // 消せるのは管理者だけで、グループのいまのコードでなくなったもの（作り直したときの前のコード）
      allow delete: if isAdmin(resource.data.groupId)
        && getAfter(groupDoc(resource.data.groupId)).data.get('joinCode', null) != code;
    }

    // 管理者が、まだ入れるあいだに、自動で入る期限を いまにする
    function stopsAutoJoin() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['autoJoinUntil'])
        && request.resource.data.autoJoinUntil == request.time
        && resource.data.get('autoJoinUntil', null) is timestamp
        && request.time < resource.data.autoJoinUntil;
    }

    // 管理者が、参加コードを（同じバッチで作った）新しいコードにする
    function setsJoinCode(groupId) {
      let code = request.resource.data.get('joinCode', null);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinCode'])
        && code is string
        && existsAfter(joinCodeDoc(code))
        && getAfter(joinCodeDoc(code)).data.groupId == groupId;
    }

    // グループの文書：autoJoinUntil（自分で入れる期限）・joinCode（いまの参加コード。#137）。読めるのはメンバー。作る・消すのはコンソールから。
    // 管理者は、まだ入れるあいだに期限を いまにする（自動で入るのを止める）ことと、参加コードを新しくすることだけができる（期限を延ばすのはコンソールから）
    match /groups/{groupId} {
      allow read: if isMember(groupId);
      allow update: if isAdmin(groupId) && (stopsAutoJoin() || setsJoinCode(groupId));
      allow create, delete: if false;

      // メンバー：role（'member' か 'admin'）・joinedAt・username（ログイン ID。#129 より前の記録にはない）。読めるのは本人と管理者。
      // 自分で作れるのは、期限の前か、受付中の参加コード（joinCode。#137）を入れて、'member' として入るときだけ（管理者にはなれない）。
      // username を入れるときは、ID トークンの名前（ログイン ID）と同じでなければならない（ほかの人の名前を名乗れない）。
      // 役割を変える・外すのは管理者だけ。自分の役割は変えられず、自分は外せない（管理者がいなくなるのを防ぐ）
      match /members/{uid} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin(groupId));
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['role', 'joinedAt', 'username', 'joinCode'])
          && request.resource.data.keys().hasAll(['role', 'joinedAt'])
          && request.resource.data.role == 'member'
          && request.resource.data.joinedAt == request.time
          && (!('username' in request.resource.data) || request.resource.data.username == request.auth.token.name)
          && (autoJoinOpen(groupId) || joinCodeOk(groupId));
        allow update: if isAdmin(groupId) && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['member', 'admin'];
        allow delete: if isAdmin(groupId) && request.auth.uid != uid;
      }

      // 投稿：読めるのはメンバーだけ。作れるのはメンバーの本人だけで、持ち主の記録（owners）を同じバッチで書く。
      // 消せるのは持ち主と管理者。もうない投稿を消すのはゆるす（管理者が消したあとも、ずかんの操作が失敗しないように）
      match /posts/{postId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId) && validPost(postId)
          && getAfter(ownerDoc(groupId, postId)).data.uid == request.auth.uid;
        allow delete: if request.auth != null
          && (resource == null || isPostOwner(groupId, postId) || isAdmin(groupId));
        allow update: if false;
      }

      // 通報：メンバーなら、グループにある投稿を通報できる（reports/{投稿の ID}__{自分の uid}。同じ人の2回目は作れない）。
      // 読める・消せるのは管理者だけ（通報した人は、ほかのメンバーに見えない）
      match /reports/{reportId} {
        allow read: if isAdmin(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.keys().hasOnly(['postId', 'createdAt'])
          && request.resource.data.keys().hasAll(['postId', 'createdAt'])
          && request.resource.data.postId is string && request.resource.data.postId.size() <= 64
          && reportId == request.resource.data.postId + '__' + request.auth.uid
          && request.resource.data.createdAt == request.time
          && exists(postDoc(groupId, request.resource.data.postId));
        allow delete: if isAdmin(groupId);
        allow update: if false;
      }

      // 投稿の持ち主（本人が消せるようにするためだけの記録）。だれも読めない（管理者も読めない）。
      // 作れるのは、まだない投稿を同じバッチで作るときだけ（ほかの人の投稿の持ち主になれない）。
      // 消すのは投稿と同じバッチ（投稿が残ったまま、持ち主の記録だけを消せない）
      match /owners/{postId} {
        allow read: if false;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid
          && !exists(postDoc(groupId, postId))
          && existsAfter(postDoc(groupId, postId));
        allow delete: if request.auth != null
          && (resource == null || resource.data.uid == request.auth.uid || isAdmin(groupId))
          && !existsAfter(postDoc(groupId, postId));
        allow update: if false;
      }
    }
  }
}
