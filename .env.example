# このファイルはキー名の見本。実際の値は .env.local に書く（git 管理外）

# ---- 開発用の切り替え -------------------------------------------------
# local にすると Firebase なしで動く（データはブラウザの localStorage に保存。パスワードは保存・確認しない）
NEXT_PUBLIC_BACKEND=firebase
# mock にすると LLM を呼ばず、サンプルの問いを返す（料金がかからない）
LLM_MODE=

# ---- LLM（サーバー側だけ。クライアントに出さない）-----------------------
ANTHROPIC_API_KEY=
# 考える深さ（low / medium / high）。まず medium で始めて比べる
LLM_EFFORT=medium

# ---- Firebase（クライアント側。公開されても問題ない値）------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- firebase-admin（サーバー側だけ。ID トークンの検証に使う）------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# 改行は \n のまま1行で書く
FIREBASE_PRIVATE_KEY=
