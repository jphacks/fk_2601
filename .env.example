# このファイルはキー名の見本。実際の値は .env.local に書く（git 管理外）

# ---- 開発用の切り替え -------------------------------------------------
# local にすると Firebase なしで動く（データはブラウザの localStorage に保存。パスワードは保存・確認しない）
NEXT_PUBLIC_BACKEND=firebase
# mock にすると LLM を呼ばず、サンプルの問いを返す（料金がかからない）
LLM_MODE=

# ---- LLM（サーバー側だけ。クライアントに出さない）-----------------------
ANTHROPIC_API_KEY=
# 考える深さ（low / medium / high）。まず medium で始めて比べる
LLM_EFFORT=medium
# 使うモデル。空なら claude-opus-5-5。安く・速くするなら claude-sonnet-5-5 か claude-haiku-5-5（質は要確認）
LLM_MODEL=
# off にすると、考える処理を止めて速くする（claude-haiku-5-5 だけ。質が下がることがある）
LLM_THINKING=

# ---- Firebase（クライアント側。公開されても問題ない値）------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- ID トークンの検証（サーバー側だけ）-----------------------------------
# 空なら NEXT_PUBLIC_FIREBASE_PROJECT_ID を使う。サービスアカウントの鍵は要らない
FIREBASE_PROJECT_ID=
